            "url": {
              "raw": "{{baseUrl}}/api/v1/words/search?q=example",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "words", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "example"
                }
              ]
            },
            "description": "Search words by query"
          }
        }
