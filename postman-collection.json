    {
      "name": "Words",
      "description": "Word management endpoints",
      "item": [
        {
          "name": "Create Word",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"word\": \"example\",\n  \"phonetic\": \"/ɪɡˈzæmpəl/\",\n  \"meanings\": [\n    {\n      \"partOfSpeech\": \"noun\",\n      \"definitions\": [\n        {\n          \"definition\": \"a representative form or pattern\",\n          \"examples\": [\"I followed her example\"]\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/words",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "words"]
            },
            "description": "Create a new word"
          }
        },
        {
          "name": "Get Word",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/words/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "words", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "507f1f77bcf86cd799439011"
                }
              ]
            },
            "description": "Get word by ID"
          }
        },
        {
          "name": "Search Words",
          "request": {
            "method": "GET",
            "header": [
